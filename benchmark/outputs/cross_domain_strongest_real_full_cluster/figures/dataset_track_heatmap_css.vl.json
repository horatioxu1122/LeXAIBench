{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Mean CSS by dataset, track, and explainer.",
  "data": {
    "url": "../by_dataset_track_explainer.csv"
  },
  "transform": [
    {
      "calculate": "datum.dataset_id + ' / ' + datum.track",
      "as": "dataset_track"
    }
  ],
  "mark": "rect",
  "encoding": {
    "x": {
      "field": "explainer_id",
      "type": "nominal",
      "title": "Explainer"
    },
    "y": {
      "field": "dataset_track",
      "type": "nominal",
      "title": "Dataset / Track",
      "sort": "ascending"
    },
    "color": {
      "field": "mean_css",
      "type": "quantitative",
      "title": "Mean CSS"
    },
    "tooltip": [
      {
        "field": "dataset_id",
        "type": "nominal",
        "title": "Dataset"
      },
      {
        "field": "track",
        "type": "nominal",
        "title": "Track"
      },
      {
        "field": "explainer_id",
        "type": "nominal",
        "title": "Explainer"
      },
      {
        "field": "mean_css",
        "type": "quantitative",
        "title": "Mean CSS"
      },
      {
        "field": "total_instances",
        "type": "quantitative",
        "title": "Instances"
      }
    ]
  }
}