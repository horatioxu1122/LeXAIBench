{
  "experiment": {
    "name": "legalbench_xai_cslaw_v2_credit_lime_default",
    "description": "LeXAIBench v2 LIME robustness run on the four-dataset credit benchmark: LIME only, in the library's default discretized mode (LimeTabularExplainer discretize_continuous=True, quartile bins; corrections option lime_discretize_continuous, which is not part of the v2 preset), so each LIME weight is the effect of the applicant's own bin rather than a slope. Every other setting, including the cslaw block (corrections v2, 24 cases, v2 taxonomy and registry), matches experiment_cslaw_v2_credit.json except the explainer list. Because v2 sampling is seeded per dataset-track-model and never depends on the explainer list, the models, sampled applicants and instance_ids line up with cslaw_v2_credit_<tag> and its LIME rows can be joined by instance_id. The run records corrections_version 'custom' (v2 plus this option) and lime_settings.discretize_continuous=true in every LIME explanation.",
    "random_seed": 42,
    "output_root": "benchmark/outputs"
  },
  "tracks": {
    "run_primary_track": true,
    "run_audit_track": true
  },
  "datasets": {
    "enabled": [
      "heloc",
      "south_german_credit",
      "default_of_credit_card_clients",
      "give_me_some_credit"
    ],
    "denied_instance_sampling": {
      "max_instances_per_dataset_model_pair": 24,
      "stratify_by_decision_margin": true,
      "strata": [
        "borderline",
        "medium_confidence",
        "strong_denial"
      ]
    }
  },
  "dataset_sources": {
    "local_paths": {
      "heloc": "benchmark/data/real/heloc.csv",
      "south_german_credit": "benchmark/data/real/south_german_credit.csv",
      "default_of_credit_card_clients": "benchmark/data/real/default_credit.csv",
      "give_me_some_credit": "benchmark/data/real/give_me_some_credit.csv"
    }
  },
  "evaluation": {
    "heldout_enabled": true,
    "split_strategy": "stratified",
    "test_fraction": 0.3,
    "split_seed": 42,
    "fallback_to_full_dataset": true
  },
  "stability_probe": {
    "enabled": true,
    "num_neighbors": 3,
    "candidate_multiplier": 6,
    "same_label_only": true,
    "lime_seed_trials": 3,
    "numeric_jitter_fraction": 0.05,
    "categorical_flip_probability": 0.15
  },
  "models": {
    "enabled": [
      "logistic_regression",
      "ebm",
      "xgboost"
    ]
  },
  "explainers": {
    "enabled": [
      "lime"
    ],
    "lime": {
      "num_seeds": 3
    }
  },
  "reporting": {
    "bootstrap": {
      "enabled": true,
      "num_resamples": 1000,
      "confidence_level": 0.95,
      "method": "hierarchical",
      "hierarchy_levels": [
        "dataset_id",
        "track",
        "model_id"
      ]
    }
  },
  "registry": {
    "dataset_registry": "benchmark/metadata/dataset_registry_v2.json",
    "feature_taxonomy": "benchmark/metadata/feature_taxonomy_v2.json",
    "paper_feature_taxonomy_manifest": "paper/feature_taxonomy_manifest_v2.yaml",
    "paper_metric_scoring_schema": "paper/metric_scoring_schema.yaml",
    "paper_canonical_explanation_schema": "paper/canonical_explanation_schema.yaml"
  },
  "cslaw": {
    "corrections": {
      "preset": "v2",
      "lime_discretize_continuous": true
    },
    "persist_canonical_explanations": true,
    "persist_native_contributions": true,
    "regb_reference": {
      "enabled": true,
      "near_cutoff_min_rows": 200,
      "near_cutoff_max_band": 0.1,
      "all_applicants_max_rows": 5000,
      "seed": 42
    },
    "shared_sampling": {
      "enabled": false,
      "scope": "models",
      "margin_aggregate": "min"
    },
    "null_baselines": {
      "faithfulness_reference": "self",
      "num_features": 6
    }
  }
}
