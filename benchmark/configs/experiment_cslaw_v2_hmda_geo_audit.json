{
  "experiment": {
    "name": "legalbench_xai_cslaw_v2_hmda_geo",
    "description": "LeXAIBench v2 HMDA re-run for E5 with geography target-encoded (corrections option geo_target_encoding, not part of the v2 preset): county and census tract are loaded as text codes and each model sees, in their place, the smoothed denial rate of the code in the training data (out of fold for training rows). Every other setting matches the published HMDA audit shard (cslaw_v2_noncredit_hmda_audit_<tag>/runtime_config.json) except the explainer list: SHAP, LIME and Anchors, the methods E5 reports for the mortgage data; the counterfactual searches never name a protected characteristic.",
    "random_seed": 42,
    "output_root": "benchmark/outputs"
  },
  "tracks": {
    "run_primary_track": false,
    "run_audit_track": true
  },
  "datasets": {
    "enabled": [
      "hmda"
    ],
    "denied_instance_sampling": {
      "max_instances_per_dataset_model_pair": 24,
      "stratify_by_decision_margin": true,
      "strata": [
        "borderline",
        "medium_confidence",
        "strong_denial"
      ]
    }
  },
  "dataset_sources": {
    "local_paths": {
      "hmda": "benchmark/data/real/hmda.csv",
      "ny_courts_pretrial": "benchmark/data/real/ny_courts_pretrial.csv",
      "fda_inspections": "benchmark/data/real/fda_inspections.csv"
    }
  },
  "evaluation": {
    "heldout_enabled": true,
    "split_strategy": "stratified",
    "test_fraction": 0.3,
    "split_seed": 42,
    "fallback_to_full_dataset": true
  },
  "stability_probe": {
    "enabled": true,
    "num_neighbors": 3,
    "candidate_multiplier": 6,
    "same_label_only": true,
    "lime_seed_trials": 3,
    "numeric_jitter_fraction": 0.05,
    "categorical_flip_probability": 0.15
  },
  "models": {
    "enabled": [
      "logistic_regression",
      "ebm",
      "xgboost"
    ]
  },
  "explainers": {
    "enabled": [
      "shap",
      "lime",
      "anchors"
    ],
    "lime": {
      "num_seeds": 3
    }
  },
  "reporting": {
    "bootstrap": {
      "enabled": true,
      "num_resamples": 1000,
      "confidence_level": 0.95,
      "method": "hierarchical",
      "hierarchy_levels": [
        "dataset_id",
        "track",
        "model_id"
      ]
    }
  },
  "registry": {
    "dataset_registry": "benchmark/metadata/dataset_registry_v2.json",
    "feature_taxonomy": "benchmark/metadata/feature_taxonomy_v2.json",
    "paper_feature_taxonomy_manifest": "paper/feature_taxonomy_manifest_v2.yaml",
    "paper_metric_scoring_schema": "paper/metric_scoring_schema.yaml",
    "paper_canonical_explanation_schema": "paper/canonical_explanation_schema.yaml"
  },
  "cslaw": {
    "corrections": {
      "preset": "v2",
      "geo_target_encoding": true
    },
    "persist_canonical_explanations": true,
    "persist_native_contributions": true,
    "regb_reference": {
      "enabled": true,
      "near_cutoff_min_rows": 200,
      "near_cutoff_max_band": 0.1,
      "all_applicants_max_rows": 5000,
      "seed": 42
    },
    "shared_sampling": {
      "enabled": false,
      "scope": "models",
      "margin_aggregate": "min"
    },
    "null_baselines": {
      "faithfulness_reference": "self",
      "num_features": 6
    }
  }
}
