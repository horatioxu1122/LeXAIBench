{
  "experiment": {
    "name": "legalbench_xai_cslaw_v2_credit_shared",
    "description": "LeXAIBench v2 shared-sampling run of the four-dataset credit benchmark. Every model and both tracks explain the same held-out applicants: those predicted adverse by all six (track, model) pairs, drawn at random within decision-margin strata of the minimum margin (seed key dataset|shared|models_and_tracks). Every other setting, including corrections v2, 24 cases, the v2 taxonomy and registry, persisted canonical explanations and native contributions, and Reg B reference means, matches experiment_cslaw_v2_credit.json. cslaw.null_baselines.faithfulness_reference stays 'self' on purpose: under corrections v2 the common native reference overrides it for scoring, and the null baseline's own weights are kept as metadata.faithfulness_evidence.self_reference_signed_contributions (self_source 'self').",
    "random_seed": 42,
    "output_root": "benchmark/outputs"
  },
  "tracks": {
    "run_primary_track": true,
    "run_audit_track": true
  },
  "datasets": {
    "enabled": [
      "heloc",
      "south_german_credit",
      "default_of_credit_card_clients",
      "give_me_some_credit"
    ],
    "denied_instance_sampling": {
      "max_instances_per_dataset_model_pair": 24,
      "stratify_by_decision_margin": true,
      "strata": [
        "borderline",
        "medium_confidence",
        "strong_denial"
      ]
    }
  },
  "dataset_sources": {
    "local_paths": {
      "heloc": "benchmark/data/real/heloc.csv",
      "south_german_credit": "benchmark/data/real/south_german_credit.csv",
      "default_of_credit_card_clients": "benchmark/data/real/default_credit.csv",
      "give_me_some_credit": "benchmark/data/real/give_me_some_credit.csv"
    }
  },
  "evaluation": {
    "heldout_enabled": true,
    "split_strategy": "stratified",
    "test_fraction": 0.30,
    "split_seed": 42,
    "fallback_to_full_dataset": true
  },
  "stability_probe": {
    "enabled": true,
    "num_neighbors": 3,
    "candidate_multiplier": 6,
    "same_label_only": true,
    "lime_seed_trials": 3,
    "numeric_jitter_fraction": 0.05,
    "categorical_flip_probability": 0.15
  },
  "models": {
    "enabled": [
      "logistic_regression",
      "ebm",
      "xgboost"
    ]
  },
  "explainers": {
    "enabled": [
      "shap",
      "lime",
      "anchors",
      "dice",
      "wachter"
    ],
    "lime": {
      "num_seeds": 3
    }
  },
  "reporting": {
    "bootstrap": {
      "enabled": true,
      "num_resamples": 1000,
      "confidence_level": 0.95,
      "method": "hierarchical",
      "hierarchy_levels": [
        "dataset_id",
        "track",
        "model_id"
      ]
    }
  },
  "registry": {
    "dataset_registry": "benchmark/metadata/dataset_registry_v2.json",
    "feature_taxonomy": "benchmark/metadata/feature_taxonomy_v2.json",
    "paper_feature_taxonomy_manifest": "paper/feature_taxonomy_manifest_v2.yaml",
    "paper_metric_scoring_schema": "paper/metric_scoring_schema.yaml",
    "paper_canonical_explanation_schema": "paper/canonical_explanation_schema.yaml"
  },
  "cslaw": {
    "corrections": "v2",
    "persist_canonical_explanations": true,
    "persist_native_contributions": true,
    "regb_reference": {
      "enabled": true,
      "near_cutoff_min_rows": 200,
      "near_cutoff_max_band": 0.10,
      "all_applicants_max_rows": 5000,
      "seed": 42
    },
    "shared_sampling": {
      "enabled": true,
      "scope": "models_and_tracks",
      "margin_aggregate": "min"
    },
    "null_baselines": {
      "faithfulness_reference": "self",
      "num_features": 6
    }
  }
}
