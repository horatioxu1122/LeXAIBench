{
  "experiment": {
    "name": "legalbench_xai_v1",
    "description": "Default paper-1 benchmark configuration for legally meaningful explanations in adverse credit decisions.",
    "random_seed": 42,
    "output_root": "benchmark/outputs"
  },
  "tracks": {
    "run_primary_track": true,
    "run_audit_track": true
  },
  "datasets": {
    "enabled": [
      "heloc",
      "default_of_credit_card_clients",
      "south_german_credit"
    ],
    "denied_instance_sampling": {
      "max_instances_per_dataset_model_pair": 1000,
      "stratify_by_decision_margin": true,
      "strata": [
        "borderline",
        "medium_confidence",
        "strong_denial"
      ]
    }
  },
  "dataset_sources": {
    "local_paths": {}
  },
  "evaluation": {
    "heldout_enabled": true,
    "split_strategy": "stratified",
    "test_fraction": 0.30,
    "split_seed": 42,
    "fallback_to_full_dataset": true
  },
  "models": {
    "enabled": [
      "logistic_regression",
      "ebm",
      "xgboost"
    ]
  },
  "explainers": {
    "enabled": [
      "shap",
      "lime",
      "anchors",
      "dice",
      "wachter"
    ],
    "lime": {
      "num_seeds": 5
    }
  },
  "registry": {
    "dataset_registry": "benchmark/metadata/dataset_registry.json",
    "feature_taxonomy": "benchmark/metadata/feature_taxonomy.json",
    "paper_feature_taxonomy_manifest": "paper/feature_taxonomy_manifest.yaml",
    "paper_metric_scoring_schema": "paper/metric_scoring_schema.yaml",
    "paper_canonical_explanation_schema": "paper/canonical_explanation_schema.yaml"
  }
}
